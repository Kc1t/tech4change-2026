{
  "name": "word-path-server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "node -e \"require('fs').rmSync('tsconfig.tsbuildinfo',{force:true})\" && nest build",
    "dev": "node -e \"require('fs').rmSync('tsconfig.tsbuildinfo',{force:true})\" && nest start --watch",
    "start": "node dist/main",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "postinstall": "prisma generate",
    "test:guardrails": "node test/cue-guardrails.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/throttler": "^6.4.0",
    "@prisma/client": "^6.1.0",
    "nestjs-zod": "^4.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "prisma": "^6.1.0",
    "typescript": "^5.7.2"
  }
}
