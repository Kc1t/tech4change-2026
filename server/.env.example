DATABASE_URL=postgresql://user:pass@localhost:5432/wordpath
PORT=3333
CORS_ORIGINS=*
ANTHROPIC_API_KEY=
CUE_MODEL=claude-sonnet-5
MODEL_BASE_URL=https://api.anthropic.com
SWAGGER_ENABLED=true

# Alternativa gratuita ao Anthropic. Se OPENAI_COMPAT_API_KEY estiver preenchida,
# ela tem precedencia. Chave gratuita em https://console.groq.com (sem cartao).
# Ajuste MODEL_BASE_URL junto se trocar de provedor.
OPENAI_COMPAT_API_KEY=
# MODEL_BASE_URL=https://api.groq.com/openai
# CUE_MODEL=llama-3.3-70b-versatile

# Gemini pela camada compativel com OpenAI. Chave gratuita em https://aistudio.google.com.
# No free tier so os modelos flash respondem; os pro devolvem 429.
# MODEL_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
# CUE_MODEL=gemini-3.6-flash
# MODEL_REASONING_EFFORT=none

# OpenRouter, com o gpt-oss-120b servido pela Cerebras.
# MODEL_BASE_URL=https://openrouter.ai/api/v1
# CUE_MODEL=openai/gpt-oss-120b
# MODEL_PROVIDER_ORDER=cerebras,groq
# MODEL_REASONING_EFFORT=low

# Transcricao em tempo real (Deepgram Flux) pelo proxy em /v1/stt. Vazio = o app usa o reconhecimento do navegador.
DEEPGRAM_API_KEY=

# Voz das dicas (ElevenLabs Flash v2.5). Vazio = o app usa a voz do aparelho.
ELEVENLABS_API_KEY=
